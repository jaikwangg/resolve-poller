<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS LaunchAgent · install.sh แทน @AGENT_DIR@ ให้
     วางที่ ~/Library/LaunchAgents = ทดสอบรายคน · /Library/LaunchAgents = ทุก user (ต้อง sudo)
     log เขียนเองที่ ~/.editortrack/agent.log (run-agent.sh) — ไม่ชนกันระหว่าง user -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kantana.editortrack.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@AGENT_DIR@/deploy/run-agent.sh</string>
  </array>
  <key>StartInterval</key><integer>600</integer>   <!-- ทุก 10 นาที -->
  <key>RunAtLoad</key><true/>
  <!-- ลำดับความสำคัญต่ำสุด: การันตีว่าไม่แย่งทรัพยากร Resolve -->
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>19</integer>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
