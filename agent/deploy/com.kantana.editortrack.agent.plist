<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS LaunchAgent · install.sh แทน @AGENT_DIR@ ให้
     วางที่ ~/Library/LaunchAgents = ทดสอบรายคน · /Library/LaunchAgents = ทุก user (ต้อง sudo)
     log เขียนเองที่ ~/.editortrack/agent.log (run-agent.sh) — ไม่ชนกันระหว่าง user -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.kantana.editortrack.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@AGENT_DIR@/deploy/run-loop.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- ใช้ loop+sleep (run-loop.sh) แทน StartInterval เพราะ macOS หน่วง StartInterval หนัก (coalescing/App Nap)
       KeepAlive = ถ้า loop ตาย launchd รีสตาร์ทให้ · ปรับช่วงเวลาที่ EDITORTRACK_INTERVAL_SEC ใน env.sh
       priority ต่ำ (Nice+LowPriorityIO) ไม่แย่ง Resolve -->
  <key>Nice</key><integer>19</integer>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
