# editortrack agent env — คัดลอกเป็น env.sh แล้วแก้ค่า:  cp env.example env.sh
# ⚠️ env.sh มี token → ถูก .gitignore ไว้ อย่า commit

# ---- role ต่อเครื่อง ----
export EDITORTRACK_ROLE=colorist          # ห้อง color · ห้อง edit ใช้ = conform
export EDITORTRACK_DETECT_GRADE=1         # ห้อง color=1 (สแกนสี) · ห้อง edit=0
export EDITORTRACK_GRADE_METHOD=lut       # lut = ExportLUT เทียบ identity (แม่นกว่า) · nodes = เกณฑ์เดิม node>1 — รัน probe_grade.py ก่อนเปิดบนห้องจริง

# ---- ปลายทาง server ----
export EDITORTRACK_SERVER=http://SERVER_IP:8000/ingest
# ใส่ URL สำรองได้ คั่นด้วย , (ลองตามลำดับ · จำตัวที่ส่งสำเร็จล่าสุดไว้ลองก่อน)
# ทุกตัวต้องเป็น server เครื่องเดียวกัน เช่น IP ใน LAN + IP ผ่าน VPN:
# export EDITORTRACK_SERVER=http://192.168.140.126:8000/ingest,http://10.8.0.1:8000/ingest
export EDITORTRACK_TOKEN=CHANGE_ME          # token ต่อเครื่อง (ผูก hostname) — บน server: python manage_tokens.py issue <hostname>
export EDITORTRACK_HTTP_TIMEOUT=5         # วิ; server ค้าง → เข้า offline queue ไม่ค้าง agent

# ---- DaVinci Resolve scripting (เลือกตาม OS) ----
# macOS:
export RESOLVE_SCRIPT_API="/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting"
export RESOLVE_SCRIPT_LIB="/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so"
# Linux (คอมเมนต์ 2 บรรทัดบน แล้วเปิด 2 บรรทัดนี้แทน):
# export RESOLVE_SCRIPT_API="/opt/resolve/Developer/Scripting"
# export RESOLVE_SCRIPT_LIB="/opt/resolve/libs/Fusion/fusionscript.so"
export PYTHONPATH="$PYTHONPATH:$RESOLVE_SCRIPT_API/Modules/"

# ---- Linux X11 เท่านั้น: ถ้า idle/frontmost อ่านไม่ได้ ลองตั้ง ----
# export DISPLAY=:0
# export XAUTHORITY="$HOME/.Xauthority"

# ---- advanced (ปกติปล่อย default) ----
# export EDITORTRACK_EXTRACT_CLIP_META=0   # ดึง meta ลึกราย clip (หนัก) — เปิดเฉพาะตอน validate ด้วย probe
# export EDITORTRACK_IDLE=90               # วิ; เกินนี้นับเป็น idle
# export EDITORTRACK_EXTRACT_SHOTS=0       # default ปิด — shot code จาก marker เป็นข้อมูลลูกค้า
# export EDITORTRACK_RESOLVE_PROCS=resolve,resolve.exe   # executable ที่นับว่า Resolve อยู่หน้าสุด (ตรงตัว ไม่ใช่ substring)
